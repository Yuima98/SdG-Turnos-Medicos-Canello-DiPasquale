{
  "info": {
    "name": "SdG Turnos Médicos - Backend Semana 1",
    "description": "Pruebas de los endpoints de autenticación (registro, login, perfil) y de soporte (health, coberturas).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "Coberturas",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/coberturas", "host": ["{{base_url}}"], "path": ["coberturas"] }
      }
    },
    {
      "name": "Auth - Registro (paciente)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', function () { pm.response.to.have.status(201); });",
              "pm.test('estructura uniforme', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('codigo');",
              "  pm.expect(json).to.have.property('estado');",
              "  pm.expect(json).to.have.property('datos');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"dni\": \"30111222\",\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"Password123!\",\n  \"fecha_nacimiento\": \"1995-05-10\",\n  \"telefono\": \"1122334455\",\n  \"id_cobertura\": 1\n}"
        },
        "url": { "raw": "{{base_url}}/auth/registro", "host": ["{{base_url}}"], "path": ["auth", "registro"] }
      }
    },
    {
      "name": "Auth - Registro (DNI duplicado)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"dni\": \"30111222\",\n  \"email\": \"otro.email@example.com\",\n  \"password\": \"Password123!\",\n  \"fecha_nacimiento\": \"1995-05-10\",\n  \"telefono\": \"1122334455\",\n  \"id_cobertura\": 1\n}"
        },
        "url": { "raw": "{{base_url}}/auth/registro", "host": ["{{base_url}}"], "path": ["auth", "registro"] }
      }
    },
    {
      "name": "Auth - Login (ok)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "if (json.datos && json.datos.token) { pm.collectionVariables.set('token', json.datos.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"30111222\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "Auth - Login (credenciales inválidas)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"30111222\",\n  \"password\": \"contraseña_incorrecta\"\n}"
        },
        "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "Auth - Perfil (con token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base_url}}/auth/perfil", "host": ["{{base_url}}"], "path": ["auth", "perfil"] }
      }
    },
    {
      "name": "Auth - Perfil (sin token -> 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', function () { pm.response.to.have.status(401); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/auth/perfil", "host": ["{{base_url}}"], "path": ["auth", "perfil"] }
      }
    },
    {
      "name": "Auth - Perfil (token inválido -> 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 401', function () { pm.response.to.have.status(401); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer token_invalido" }],
        "url": { "raw": "{{base_url}}/auth/perfil", "host": ["{{base_url}}"], "path": ["auth", "perfil"] }
      }
    }
  ]
}
